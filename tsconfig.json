{
  "compilerOptions": {
    "types": [
      "node",
      "vitest/importMeta"
    ],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "declaration": true,
    "noImplicitAny": false,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
  },
  "include": [
    "app",
    "texttests/golden-master-text-test.ts",
    "solutions/test"
  ],
  "exclude": [
    "node_modules"
  ]
}